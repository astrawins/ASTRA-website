{
  "headers": [
    {
      "source": "/(portal|client-portal|login|app)/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.googleapis.com https://sheets.googleapis.com https://gmail.googleapis.com https://accounts.google.com https://graph.facebook.com https://api.telegram.org; frame-src https://accounts.google.com https://calendar.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/app/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/services/seo/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/el/ypiresies/seo-iatreion/",
      "destination": "/el/",
      "permanent": true
    },
    {
      "source": "/services/paid-ads/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/social-media/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/el/ypiresies/diafimisi-google-meta/",
      "destination": "/el/",
      "permanent": true
    },
    {
      "source": "/el/ypiresies/social-media/",
      "destination": "/el/",
      "permanent": true
    },
    {
      "source": "/el/ypiresies/",
